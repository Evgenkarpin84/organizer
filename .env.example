# Скопируй этот файл в .env и подставь значения.
# Переменные с префиксом VITE_ попадают в браузер, остальные — только для скриптов на ПК.

# --- Приложение (Supabase → Project Settings → API Keys) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Публичный ключ VAPID для push-уведомлений: получить командой `npm run vapid`.
# Приватный ключ в этот файл не кладём — он живёт только в секретах Edge Function.
VITE_VAPID_PUBLIC_KEY=

# --- Скрипты на ПК: сбор почты ---
# Сервисный ключ обходит RLS, поэтому во фронтенд он не попадает никогда.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Идентификатор владельца: Supabase → Authentication → Users → колонка UID.
OWNER_USER_ID=

# Ящики: провайдер mailru или yandex, пароль — «пароль приложения», не основной.
MAIL_1_PROVIDER=mailru
MAIL_1_EMAIL=
MAIL_1_PASSWORD=
MAIL_1_LABEL=

MAIL_2_PROVIDER=mailru
MAIL_2_EMAIL=
MAIL_2_PASSWORD=
MAIL_2_LABEL=

MAIL_3_PROVIDER=mailru
MAIL_3_EMAIL=
MAIL_3_PASSWORD=
MAIL_3_LABEL=

MAIL_4_PROVIDER=yandex
MAIL_4_EMAIL=
MAIL_4_PASSWORD=
MAIL_4_LABEL=

# Пределы первого запуска: за сколько дней забирать письма и сколько максимум за раз.
MAIL_BACKFILL_DAYS=30
MAIL_MAX_PER_RUN=200
